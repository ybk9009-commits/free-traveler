# CI-DEPLOY-VERCEL-SUPABASE-CHECK — 필요한 환경변수 이름 목록(값은 비워 둔다).
# 실제 값은 .env.local(git에 커밋하지 않음) 또는 Vercel 프로젝트의
# Environment Variables 설정에만 넣는다.

# --- Supabase (필수) ---
# Supabase 프로젝트 Settings > API에서 확인한다. 둘 다 브라우저에 노출되는
# 값이므로 NEXT_PUBLIC_ 접두사가 붙어 있다(anon key는 RLS를 우회하지 않음).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용(Route Handler/Server Action에서만 사용, RLS를 우회한다).
# CLAUDE.md 규칙 15 — 절대 NEXT_PUBLIC_ 접두사로 노출하거나 Client Component
# 코드에서 참조하지 않는다. 값이 없으면 관련 기능(app_settings 조회)은
# "설정되지 않음" 상태로 안전하게 대체된다(src/app/travel-tools/page.tsx).
SUPABASE_SERVICE_ROLE_KEY=

# --- 배포 도메인(선택) ---
# 회원가입 이메일 인증 콜백 URL(src/lib/auth/session.ts)을 만드는 데 쓴다.
# 비워 두면 http://localhost:3000으로 대체된다 — Vercel 배포 시 실제 도메인
# (예: https://free-traveler.vercel.app)으로 반드시 설정해야 한다.
NEXT_PUBLIC_SITE_URL=

# --- Playwright(선택) ---
# 이미 배포된 환경(Vercel Preview 등)을 대상으로 E2E를 돌릴 때만 설정한다.
# 비워 두면 로컬 dev 서버(npm run dev)를 직접 띄워서 사용한다.
PLAYWRIGHT_BASE_URL=

# --- E2E/통합 테스트 전용 계정(선택) ---
# 실제 개인정보를 쓰지 않는다. 이메일 인증을 마치고 Supabase Auth에 미리
# 만들어 둔 테스트 계정이어야 한다(회원가입 자체는 자동화하지 않음 —
# docs/PROJECT_SCOPE.md §8 "외부 이메일 사업자 연동" 제외 범위).
# 값이 없으면 관련 시나리오는 실패하지 않고 깨끗하게 skip된다.

# tests/e2e/auth-smoke.spec.ts
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=

# tests/e2e/mate-auth.spec.ts, tests/integration/rls.test.ts,
# tests/unit/mate-state.test.ts — 동행 모집글 작성자 역할.
E2E_TEST_OWNER_EMAIL=
E2E_TEST_OWNER_PASSWORD=

# 위와 동일한 파일들 — 참가 신청자 역할(작성자와 다른 계정이어야 한다).
E2E_TEST_APPLICANT_EMAIL=
E2E_TEST_APPLICANT_PASSWORD=

# tests/e2e/mate-auth.spec.ts, tests/integration/rls.test.ts —
# Supabase Auth의 app_metadata.role이 "MODERATOR" 또는 "ADMIN"으로 설정된
# 계정이어야 한다(Supabase Dashboard나 Admin API로 직접 설정, 앱 코드로는
# 설정할 수 없다).
E2E_TEST_ADMIN_EMAIL=
E2E_TEST_ADMIN_PASSWORD=
